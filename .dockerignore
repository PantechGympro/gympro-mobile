# Dependencias — se reinstalan dentro del contenedor con npm install
node_modules/

# Proyecto nativo Android — no lo usa este contenedor (solo corre Metro/Expo
# dev server vía entrypoint.sh); se compila con `expo run:android`/EAS, fuera
# de Docker.
android/

# Cache/artefactos de Expo y builds web
.expo/
dist/
web-build/
expo-env.d.ts

# Variables de entorno locales
.env
.env.*
!.env.example

# Git y editor
.git/
.gitignore
.vscode/
.idea/

# CI, documentación y licencias — no se usan en runtime
.github/
docs/
README.md
*.md
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# OS artifacts
.DS_Store
Thumbs.db

# Config/skills de Claude Code — herramientas de desarrollo, no pertenecen a la imagen
.claude/
